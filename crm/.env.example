PORT=4000
NODE_ENV=development

# Postgres (docker-compose local por defecto)
DATABASE_URL=postgresql://menugo:menugo@localhost:5432/menugo

# Ubicación por defecto que usa Cataleya al crear pedidos
LOCATION_SLUG=cataleya

# Orígenes permitidos para CORS, separados por coma (Cataleya + panel CRM)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Meta WhatsApp Cloud API (dejar vacío hasta tener cuenta de WhatsApp Business)
WHATSAPP_VERIFY_TOKEN=changeme
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Supabase Auth — URL del proyecto (Project Settings → API → Project URL).
# Se usa para validar los access tokens contra el JWKS público de Supabase.
SUPABASE_URL=https://qatkkaphfdkxwosndeii.supabase.co
